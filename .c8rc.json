{
  "all": true,
  "include": ["scripts/**/*.mjs", "*.{js,cjs,mjs}"],
  "exclude": ["**/*.test.mjs", "**/*.spec.mjs"],
  "extension": [".js", ".cjs", ".mjs"],
  "exclude-after-remap": true,
  "reporter": ["text-summary", "lcov", "json-summary"],
  "reports-dir": "coverage",
  "temp-directory": "coverage/tmp",
  "clean": true,
  "check-coverage": true,
  "per-file": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
