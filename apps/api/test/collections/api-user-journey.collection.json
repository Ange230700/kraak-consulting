  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('journeyEmail')) {",
          "  pm.collectionVariables.set('journeyEmail', 'kraak.postman.' + Date.now() + '@gmail.com');",
          "}",
          "if (!pm.variables.get('strictAuth')) {",
          "  pm.collectionVariables.set('strictAuth', 'false');",
          "}",
          "if (!pm.collectionVariables.get('journeyPassword')) {",
          "  pm.collectionVariables.set('journeyPassword', 'Kraak!Pass12345');",
          "}",
          "if (!pm.collectionVariables.get('useExistingConfirmedUser')) {",
          "  pm.collectionVariables.set('useExistingConfirmedUser', 'false');",
          "}",
          "if (!pm.collectionVariables.get('confirmedJourneyEmail')) {",
          "  pm.collectionVariables.set('confirmedJourneyEmail', '');",
          "}",
          "if (!pm.collectionVariables.get('confirmedJourneyPassword')) {",
          "  pm.collectionVariables.set('confirmedJourneyPassword', '');",
          "}",
          "if (!pm.collectionVariables.get('authEmail')) {",
          "  pm.collectionVariables.set('authEmail', '');",
          "}",
          "if (!pm.collectionVariables.get('authPassword')) {",
          "  pm.collectionVariables.set('authPassword', '');",
          "}",
          "if (!pm.collectionVariables.get('authBlocked')) {",
          "  pm.collectionVariables.set('authBlocked', 'false');",
          "}",
          "const useExistingConfirmedUser = String(pm.variables.get('useExistingConfirmedUser') ?? pm.collectionVariables.get('useExistingConfirmedUser') ?? 'false') === 'true';",
          "const confirmedJourneyEmail = String(pm.variables.get('confirmedJourneyEmail') ?? pm.collectionVariables.get('confirmedJourneyEmail') ?? '');",
          "const confirmedJourneyPassword = String(pm.variables.get('confirmedJourneyPassword') ?? pm.collectionVariables.get('confirmedJourneyPassword') ?? '');",
          "pm.collectionVariables.set('useExistingConfirmedUser', useExistingConfirmedUser ? 'true' : 'false');",
          "pm.collectionVariables.set('confirmedJourneyEmail', confirmedJourneyEmail);",
          "pm.collectionVariables.set('confirmedJourneyPassword', confirmedJourneyPassword);",
          "pm.collectionVariables.set('authEmail', useExistingConfirmedUser && confirmedJourneyEmail ? confirmedJourneyEmail : pm.collectionVariables.get('journeyEmail'));",
          "pm.collectionVariables.set('authPassword', useExistingConfirmedUser && confirmedJourneyPassword ? confirmedJourneyPassword : pm.collectionVariables.get('journeyPassword'));",
          "if (!pm.collectionVariables.get('announcementId')) {",
          "  pm.collectionVariables.set('announcementId', '');",
          "}",
          "if (!pm.collectionVariables.get('programId')) {",
          "  pm.collectionVariables.set('programId', '');",
          "}",
          "if (!pm.collectionVariables.get('resourceId')) {",
          "  pm.collectionVariables.set('resourceId', '');",
          "}",
          "if (!pm.collectionVariables.get('participantProgramId')) {",
          "  pm.collectionVariables.set('participantProgramId', '');",
          "}",
          "if (!pm.collectionVariables.get('participantAnnouncementId')) {",
          "  pm.collectionVariables.set('participantAnnouncementId', '');",
          "}",
          "if (!pm.collectionVariables.get('supportRequestId')) {",
          "  pm.collectionVariables.set('supportRequestId', '');",
          "}"
        ]
      }
    }
  ],
