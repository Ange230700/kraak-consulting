        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jean Dupont\",\n  \"email\": \"{{journeyEmail}}\",\n  \"subject\": \"Question de suivi\",\n  \"message\": \"Je souhaite un accompagnement personnalisé pour mon parcours.\",\n  \"category\": \"program\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/support/contact",
          "host": ["{{baseUrl}}"],
          "path": ["support", "contact"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body = {};",
              "try {",
              "  body = pm.response.json();",
              "} catch (error) {",
              "  body = {};",
              "}",
              "const blocked = pm.collectionVariables.get('authBlocked') === 'true';",
              "if (!blocked && body.requestId) {",
              "  pm.collectionVariables.set('supportRequestId', String(body.requestId));",
              "}",
              "if (blocked) {",
              "  pm.test('Given sign-in failed When submitting support request with invalid token Then status is 200 (anonymous fallback)', function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "} else {",
              "  pm.test('Given authenticated participant When submitting support request Then status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "  pm.test('Given authenticated participant When submitting support request Then a tracked request id is returned', function () {",
              "    pm.expect(typeof body.requestId).to.eql('string');",
              "    pm.expect(body.requestId.length).to.be.greaterThan(0);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Support Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/support/requests",
          "host": ["{{baseUrl}}"],
          "path": ["support", "requests"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const blocked = pm.collectionVariables.get('authBlocked') === 'true';",
              "if (blocked) {",
              "  pm.test('Given sign-in failed When listing support requests Then status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "  });",
              "} else {",
              "  pm.test('Given authenticated participant When listing support requests Then status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "  const body = pm.response.json();",
              "  const supportRequestId = pm.collectionVariables.get('supportRequestId');",
              "  pm.test('Given authenticated participant When listing support requests Then the response is an array', function () {",
              "    pm.expect(Array.isArray(body)).to.eql(true);",
              "  });",
              "  if (supportRequestId) {",
              "    pm.test('Given a newly created support request When listing support requests Then the request is present', function () {",
              "      pm.expect(body.some((item) => String(item.id) === supportRequestId)).to.eql(true);",
              "    });",
              "  }",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
