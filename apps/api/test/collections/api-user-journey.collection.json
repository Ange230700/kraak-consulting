    {
      "name": "Sign Up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{journeyEmail}}\",\n  \"password\": \"{{journeyPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Journey\",\n  \"phone\": null,\n  \"preferredContactChannel\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/sign-up",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sign-up"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('useExistingConfirmedUser') === 'true') {",
              "  pm.collectionVariables.set('authBlocked', 'false');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body = {};",
              "try {",
              "  body = pm.response.json();",
              "} catch (error) {",
              "  body = {};",
              "}",
              "const message = String(body.message || '').toLowerCase();",
              "const strictAuth = String(pm.variables.get('strictAuth')) === 'true';",
              "const requiresEmailConfirmation = body.requiresEmailConfirmation === true;",
              "const blockedByProvider = pm.response.code === 400 && (",
              "  message.includes('déjà') ||",
              "  message.includes('already') ||",
              "  message.includes('invalide') ||",
              "  message.includes('invalid') ||",
              "  message.includes('limite') ||",
              "  message.includes('rate') ||",
              "  message.includes('indisponible') ||",
              "  message.includes('temporarily unavailable')",
              ");",
              "const authBlocked = requiresEmailConfirmation || blockedByProvider;",
              "pm.collectionVariables.set('authBlocked', authBlocked ? 'true' : 'false');",
              "pm.test('Given sign-up payload When creating account Then status is deterministic for selected mode', function () {",
              "  if (strictAuth) {",
              "    pm.response.to.have.status(201);",
              "  } else if (authBlocked) {",
              "    pm.expect([201, 400]).to.include(pm.response.code);",
              "  } else {",
              "    pm.response.to.have.status(201);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign In",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/sign-in",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sign-in"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const blocked = pm.collectionVariables.get('authBlocked') === 'true';",
              "const strictAuth = String(pm.variables.get('strictAuth')) === 'true';",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body && body.session && body.session.accessToken) {",
              "    pm.collectionVariables.set('accessToken', body.session.accessToken);",
              "    pm.collectionVariables.set('refreshToken', body.session.refreshToken || '');",
              "    pm.collectionVariables.set('authBlocked', 'false');",
              "  } else {",
              "    pm.collectionVariables.set('authBlocked', 'true');",
              "  }",
              "} else {",
              "  pm.collectionVariables.set('authBlocked', 'true');",
              "}",
              "pm.test('Given credentials When signing in Then status is deterministic for selected mode', function () {",
              "  if (strictAuth) {",
              "    pm.response.to.have.status(200);",
              "  } else if (blocked) {",
              "    pm.expect([200, 401]).to.include(pm.response.code);",
              "  } else {",
              "    pm.response.to.have.status(200);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
