{
  "name": "kraak-consulting",
  "version": "0.0.0",
  "private": true,
  "description": "KRAAK — Monorepo for the web platform, API, and shared packages",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.23.0"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "clean": "pnpm -r clean && node ./scripts/clean.mjs",
    "dev": "node ./scripts/dev-all.mjs",
    "sonar": "node ./scripts/sonarcloud-scan.mjs",
    "check": "node ./scripts/quality-gate.mjs",
    "check:full": "node ./scripts/quality-gate.mjs --full",
    "coverage": "pnpm test:coverage",
    "build:libs": "pnpm --filter @kraak/contracts --filter @kraak/domain build",
    "build": "pnpm build:web && pnpm build:mobile && pnpm build:api",
    "test": "node ./scripts/workspace-runner.mjs test",
    "dev:web": "pnpm --filter @kraak/client run dev:web",
    "build:web": "pnpm --filter @kraak/client build",
    "build:web:local": "pnpm --filter @kraak/client run build:web:local",
    "dev:mobile": "pnpm --filter @kraak/client run dev:mobile --port 4300",
    "build:mobile": "pnpm --filter @kraak/client build:mobile",
    "build:mobile:local": "pnpm --filter @kraak/client run build:mobile:local",
    "cap:sync": "pnpm --filter @kraak/client cap:sync",
    "build:debug:android": "pnpm --filter @kraak/client build:debug:android",
    "build:debug:ios": "pnpm --filter @kraak/client build:debug:ios",
    "dev:api": "pnpm --filter @kraak/api dev",
    "splinter:local": "pnpm exec supabase db advisors --local --type all --level warn --fail-on warn",
    "splinter:linked": "pnpm exec supabase db advisors --linked --type all --level error --fail-on error",
    "splinter:linked:warnings": "pnpm exec supabase db advisors --linked --type all --level warn --fail-on warn",
    "splinter:security:linked": "pnpm exec supabase db advisors --linked --type security --level warn --fail-on warn",
    "splinter:performance:linked": "pnpm exec supabase db advisors --linked --type performance --level warn --fail-on warn",
    "splinter:sec": "pnpm splinter:security:linked",
    "splinter:perf": "pnpm splinter:performance:linked",
    "build:api": "pnpm --filter @kraak/api build",
    "check:observability": "node ./scripts/check-observability.mjs",
    "check:branch-lineage": "node ./scripts/github/check-branch-lineage.mjs",
    "i18n:check": "node ./scripts/check-i18n-catalogs.mjs",
    "docs:audit": "bash scripts/audit-docs.sh --output .reports/docs-audit",
    "docs:audit:full": "bash scripts/audit-docs.sh --full --output .reports/docs-audit",
    "docs:audit:strict": "bash scripts/audit-docs.sh --full --fail-on-findings --output .reports/docs-audit",
    "docs:index:check": "node scripts/generate-docs-index.mjs --check",
    "docs:index:write": "node scripts/generate-docs-index.mjs --write",
    "docs:toc:check": "node scripts/generate-markdown-tocs.mjs --check",
    "docs:toc:write": "node scripts/generate-markdown-tocs.mjs --write",
    "docs:export": "node scripts/export-docs.mjs",
    "test:docs:export": "node --test scripts/export-docs.test.mjs scripts/artifacts/model.test.mjs scripts/artifacts/engine.test.mjs scripts/artifacts/identity.test.mjs scripts/artifacts/narration.test.mjs scripts/artifacts/presentation.test.mjs scripts/artifacts/transaction.test.mjs",
    "test:docs:export:integration": "node --test --test-concurrency=1 scripts/export-docs.integration.test.mjs scripts/export-docs.cli.test.mjs scripts/artifacts/mermaid.test.mjs scripts/artifacts/render.test.mjs scripts/artifacts/verify.test.mjs scripts/artifacts/visual-qa.test.mjs scripts/artifacts/engine.integration.test.mjs",
    "test:workspace": "node --test --test-concurrency=4 \"scripts/**/*.test.mjs\" \"scripts/**/*.spec.mjs\"",
    "test:workspace:coverage": "c8 pnpm test:workspace",
    "test:api": "pnpm --filter @kraak/api test",
    "test:api:journey": "pnpm exec newman run apps/api/test/collections/api-user-journey.collection.json --reporters cli,json --reporter-json-export test-results/postman/api-user-journey.report.json",
    "test:api:journey:strict": "pnpm exec newman run apps/api/test/collections/api-user-journey.collection.json --reporters cli,json --reporter-json-export test-results/postman/api-user-journey.report.json --env-var strictAuth=true",
    "test:libs": "pnpm -r --filter @kraak/contracts --filter @kraak/domain --filter @kraak/api-client --filter @kraak/tokens test",
    "test:api:unit": "pnpm --filter @kraak/api test:unit",
    "test:integration": "pnpm --filter @kraak/api test:integration",
    "test:coverage": "pnpm build:libs && node ./scripts/quality-gate.mjs --coverage",
    "test:api:coverage": "pnpm --filter @kraak/api test:cov --runInBand",
    "test:client:coverage": "pnpm --filter @kraak/client test:coverage",
    "test:libs:coverage": "pnpm -r --no-bail --filter @kraak/contracts --filter @kraak/domain --filter @kraak/api-client --filter @kraak/tokens test:coverage",
    "lint:api": "pnpm --filter @kraak/api lint",
    "lint": "pnpm lint:code && pnpm splinter:linked",
    "lint:code": "pnpm lint:root && pnpm -r lint && pnpm lint:markdown",
    "lint:fix": "pnpm lint:root:fix && pnpm -r lint:fix && pnpm lint:markdown:fix",
    "lint:root": "eslint \"scripts/**/*.{js,cjs,mjs}\" \"*.{js,cjs,mjs,jsonc}\" \"apps/*/eslint.config.{js,cjs,mjs}\" \"packages/*/eslint.config.{js,cjs,mjs}\"",
    "lint:root:fix": "eslint \"scripts/**/*.{js,cjs,mjs}\" \"*.{js,cjs,mjs,jsonc}\" \"apps/*/eslint.config.{js,cjs,mjs}\" \"packages/*/eslint.config.{js,cjs,mjs}\" --fix",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "affected:lint": "node ./scripts/affected-workspaces.mjs lint",
    "affected:test": "node ./scripts/affected-workspaces.mjs test",
    "affected:build": "node ./scripts/affected-workspaces.mjs build",
    "typecheck:web": "pnpm --filter @kraak/client exec tsc --noEmit -p projects/web/tsconfig.app.json",
    "typecheck:mobile": "pnpm --filter @kraak/client exec tsc --noEmit -p projects/mobile/tsconfig.app.json",
    "typecheck:api": "pnpm --filter @kraak/api exec tsc --noEmit -p tsconfig.build.json",
    "typecheck:libs": "pnpm --filter @kraak/contracts --filter @kraak/domain --filter @kraak/api-client --filter @kraak/tokens exec tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm build:libs && pnpm typecheck:libs && pnpm typecheck:web && pnpm typecheck:mobile && pnpm typecheck:api",
    "test:unit": "pnpm --filter @kraak/client test",
    "test:e2e": "pnpm test:e2e:web",
    "test:e2e:web": "pnpm --filter @kraak/client e2e",
    "test:e2e:mobile": "pnpm --filter @kraak/client exec playwright test --config=playwright.mobile.config.ts",
    "test:e2e:all": "pnpm test:e2e:web && pnpm test:e2e:mobile",
    "check:prepilot:web": "pnpm --filter @kraak/client e2e:prepilot",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs,html,scss,css,json,jsonc,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs,html,scss,css,json,jsonc,md,yml,yaml}\"",
    "precommit:staged": "lint-staged --concurrent false",
    "prepush:smart": "node ./scripts/husky-pre-push.mjs",
    "commit": "git-cz",
    "prepare": "husky",
    "save": "git add . && pnpm commit && git push origin HEAD",
    "changesets:version": "changeset version",
    "changesets:publish": "changeset publish",
    "docs:verify": "node scripts/export-docs.mjs --operation verify",
    "docs:visual-qa": "node scripts/export-docs.mjs --operation visual-qa",
    "docs:plan": "node scripts/export-docs.mjs --operation plan"
  },
  "validate-branch-name": {
    "pattern": "^(main|(feat|fix|chore|docs|test|refactor|ci|style|perf|revert|build|copilot)/.+)$",
    "errorMsg": "Le nom de branche doit suivre le format <type>/<sujet> (ex: feat/login-page, fix/header-layout) ou être 'main'"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "0.1.100",
    "@vitest/coverage-v8": "4.1.4",
    "@xmldom/xmldom": "0.8.15",
    "c8": "^12.0.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "entities": "6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jsonc": "^3.3.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jszip": "3.10.1",
    "lint-staged": "^16.2.6",
    "markdownlint-cli2": "^0.23.2",
    "marked": "17.0.1",
    "mermaid": "11.12.0",
    "newman": "6.2.3",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.59.1",
    "pptxgenjs": "4.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "validate-branch-name": "^1.3.2"
  }
}
